# Copy to mobile/.env and fill in. Expo only exposes variables that start with EXPO_PUBLIC_.

# Backend URL. The iOS simulator can reach your Mac at localhost.
# A physical phone cannot: use your Mac's LAN IP instead (e.g. http://192.168.1.20:8000).
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase project: Project Settings > API. The anon key is safe to ship in the app;
# row level security in the database is what actually protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
