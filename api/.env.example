# Copy this file to .env and fill in your values
# cp api/.env.example api/.env

# Supabase — leave blank to disable analytics/feedback locally
SUPABASE_URL=
SUPABASE_KEY=

# Hosted key (used when SHOW_API_INPUT=false — server-side provider)
HOSTED_API_KEY=
HOSTED_PROVIDER=groq

# true  → form shows provider/API key input fields (user brings their own key)
# false → form hides them, uses HOSTED_API_KEY above
SHOW_API_INPUT=true

# false → disables all Supabase writes (use locally to keep test data out of prod)
ENABLE_LOGGING=false
