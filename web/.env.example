NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project — Project Settings → API in the Supabase dashboard.
# The anon key is safe to expose client-side; RLS policies (see
# supabase/migrations/0001_core_schema.sql) are what actually enforce access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# true  → show provider / API key fields (user brings their own key)
# false → hide those fields, API uses a hosted key from the backend
NEXT_PUBLIC_SHOW_API_INPUT=true

# Analytics — set to true only when you want events to reach Supabase
# Leave false locally so dev traffic never pollutes the prod table
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Tag every analytics row with the environment it came from (dev / prod)
# Set to "prod" in Railway, leave as "dev" locally
NEXT_PUBLIC_ENV=dev
